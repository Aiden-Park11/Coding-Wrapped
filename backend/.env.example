# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 .gitignore 로 커밋되지 않음)
# cp .env.example .env

# GitHub App 설정 페이지 주소의 마지막 부분 (github.com/apps/<여기>)
GH_APP_SLUG=
GH_CLIENT_ID=
GH_CLIENT_SECRET=

# 이 서버의 주소. 배포하면 https://... 로 바꾸고, GitHub App 의 Callback URL 도 같이 바꾸기
BASE_URL=http://localhost:8000

# 분석 기간 (이 해의 1월 1일부터)
WRAPPED_YEAR=2026

# 속도 조절 (기본값 그대로 써도 됨)
MAX_COMMITS_PER_REPO=1000
MAX_DETAIL_COMMITS=60
GH_CONCURRENCY=8
